---
// src/pages/index.astro
import LayoutPJ from '../layouts/LayoutPJ.astro';
import comunicados from '../data/comunicados-noticias.json';
import HeaderPJ from '../components/HeaderPJ.astro';
import FooterPJ from '../components/FooterPJ.astro';
import LinkPJ from '../components/LinkPJ.astro';
import Carrusel from '../components/Carrusel.astro';

// 2. Mapeamos las imágenes de la carpeta assets
const imagenesAssets = import.meta.glob('../assets/*.{png,jpg,jpeg,svg}', { eager: true });
---

<LayoutPJ title="Inicio - Modernización PJECZ">
    
    <HeaderPJ />

    <!-- Carrusel integrado justo debajo del Header -->
    <Carrusel />

    <main>
        <div class="bg-gradient-to-r from-blue-900 to-indigo-950 p-8 rounded-2xl shadow-lg text-center max-w-4xl mx-auto mt-6 text-white space-y-4">
            <h2 class="text-3xl font-bold tracking-tight">Portal de Modernización Web</h2>
            <p class="text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">
                Entorno base desarrollado en Astro con Tailwind CSS. Accede de manera ágil a los servicios institucionales y gacetas informativas del estado.
            </p>
            <div class="pt-2">
                <a href="/buscar" class="inline-block bg-white hover:bg-gray-100 text-blue-900 text-sm font-semibold px-6 py-3 rounded-xl transition shadow-md">
                    Ir al Buscador de Acuerdos
                </a>
            </div>
        </div>

        <div class="mt-16 max-w-6xl mx-auto">
            <h3 class="text-2xl font-bold text-gray-800 mb-6 tracking-tight border-b border-gray-200 pb-3">
                Últimos Comunicados y Convocatorias
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {comunicados.data.map((item: { date: string; title: string; summary: string; imagen?: string }) => {
                    const rutaBuscada = `../assets/${item.imagen}`;
                    const imagenProcesada = imagenesAssets[rutaBuscada];

                    return (
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col hover:shadow-md transition duration-300">
                            <div class="w-full h-48 bg-gray-100 overflow-hidden relative border-b border-gray-100">
                                <img 
                                    src={imagenProcesada ? (imagenProcesada as any).default.src : '../assets/navegacion-logotipo.png'} 
                                    alt={item.title}
                                    class="w-full h-full object-cover hover:scale-105 transition duration-500"
                                    loading="lazy"
                                />
                            </div>
                            <div class="p-5 grow flex flex-col justify-between space-y-3">
                                <div class="space-y-2">
                                    <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md">
                                        {item.date}
                                    </span>
                                    <h4 class="font-bold text-gray-800 text-base leading-snug line-clamp-2">
                                        {item.title}
                                    </h4>
                                    <p class="text-gray-600 text-xs leading-relaxed line-clamp-3">
                                        {item.summary}
                                    </p>
                                </div>
                                <div class="pt-2">
                                    <button class="w-full text-center bg-gray-50 hover:bg-blue-50 text-gray-700 hover:text-blue-700 text-xs font-semibold py-2 rounded-lg border border-gray-200 hover:border-blue-200 transition">
                                        Leer comunicado completo
                                    </button>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </main>

    <FooterPJ />

</LayoutPJ>