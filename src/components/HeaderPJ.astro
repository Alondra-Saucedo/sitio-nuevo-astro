---
// src/components/HeaderPJ.astro
---

<header class="w-full">
    <div
        class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center bg-white"
    >
        <img
            src="/assets/navegacion-logotipo.png"
            alt="Poder Judicial Coahuila"
            class="h-16 w-auto"
        />
        <div class="flex gap-4 opacity-70">
            <div class="w-8 h-8 bg-gray-300 rounded-full"></div>
            <div class="w-8 h-8 bg-gray-300 rounded-full"></div>
            <div class="w-8 h-8 bg-gray-300 rounded-full"></div>
            <div class="w-8 h-8 bg-gray-300 rounded-full"></div>
        </div>
    </div>

    <div class="bg-[#56653a] text-white">
        <div
            class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between"
        >
            <nav
                class="flex gap-8 text-sm font-semibold uppercase tracking-wide"
            >
                <a href="#" class="flex items-center gap-1 hover:text-gray-200"
                    >CONÓCENOS ▾</a
                >
                <a href="#" class="flex items-center gap-1 hover:text-gray-200"
                    >CONSULTAS ▾</a
                >
                <a href="#" class="flex items-center gap-1 hover:text-gray-200"
                    >SALA DE PRENSA ▾</a
                >
                <a href="#" class="flex items-center gap-1 hover:text-gray-200"
                    >TRANSPARENCIA ▾</a
                >
                <a href="#" class="hover:text-gray-200">ESTUDIANTES</a>
            </nav>

            <div
                class="buscador-container w-64 h-9 bg-white rounded flex items-center px-2 border border-gray-300"
            >
                <svg
                    class="w-5 h-5 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <div class="gcse-searchbox-only w-full"></div>
            </div>
        </div>
    </div>
</header>

<style is:global>
    .buscador-container .gsc-control-cse {
        padding: 0 !important;
        border: none !important;
        background: transparent !important;
    }
    .buscador-container .gsc-input-box {
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
    }
    .buscador-container input.gsc-input {
        padding: 0 5px !important;
        height: 30px !important;
        font-size: 14px !important;
    }
    .buscador-container .gsc-search-button {
        display: none !important;
    }
    .buscador-container .gsc-branding-text {
        font-size: 10px !important;
        color: #777 !important;
    }
</style>

<script async src="https://cse.google.com/cse.js?cx=33664f175580b4923"></script>
