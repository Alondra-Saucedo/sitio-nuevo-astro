---
// src/pages/buscar.astro
import LayoutPJ from '../layouts/LayoutPJ.astro';
---

<LayoutPJ title="Buscador de Acuerdos - PJECZ">
    <div class="max-w-4xl mx-auto space-y-6">
        
        <!-- ENCABEZADO DE LA SECCIÓN -->
        <div class="text-center sm:text-left">
            <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Consulta de Acuerdos y Boletines</h2>
            <p class="text-sm text-gray-600 mt-1">
                Ingresa el número de expediente, actor o palabras clave para buscar información de forma inmediata.
            </p>
        </div>

        <!-- BARRA DE BÚSQUEDA -->
        <div class="bg-white p-4 rounded-xl shadow border border-gray-200">
            <div class="relative">
                <input 
                    type="text" 
                    id="input-busqueda"
                    placeholder="Ej. 124/2025, Familiar, Mercantil..." 
                    class="w-full pl-4 pr-12 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition text-sm"
                />
                <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-400">
                    🔍
                </div>
            </div>
            <div class="flex items-center justify-between mt-3 text-xs text-gray-500 px-1">
                <span>⚡ Búsqueda optimizada (Sin CAPTCHA)</span>
                <span id="contador-resultados">Escribe para comenzar...</span>
            </div>
        </div>

        <!-- CONTENEDOR DE RESULTADOS -->
        <div id="contenedor-resultados" class="space-y-3">
            <!-- Los resultados se pintarán dinámicamente aquí mediante JavaScript -->
            <div class="bg-white p-6 rounded-xl border border-dashed border-gray-300 text-center text-gray-500 text-sm">
                Utiliza la barra superior para buscar registros institucionales.
            </div>
        </div>

    </div>
</LayoutPJ>

<script>
    // IMPORTACIÓN DE DATOS JSON
    import datosAcuerdos from '../data/acuerdos.json';

    // Accedemos directamente a la propiedad 'data' que es el arreglo real
    const listaAcuerdos = datosAcuerdos.data as any[];

    const inputBusqueda = document.getElementById('input-busqueda') as HTMLInputElement | null;
    const contenedorResultados = document.getElementById('contenedor-resultados');
    const contadorResultados = document.getElementById('contador-resultados');

    // Función encargada de filtrar y pintar los acuerdos en tiempo real
    function filtrarDatos() {
        if (!inputBusqueda || !contenedorResultados || !contadorResultados) return;

        const termino = inputBusqueda.value.toLowerCase().trim();

        if (termino === '') {
            contenedorResultados.innerHTML = `
                <div class="bg-white p-6 rounded-xl border border-dashed border-gray-300 text-center text-gray-500 text-sm">
                    Utiliza la barra superior para buscar registros institucionales.
                </div>
            `;
            contadorResultados.textContent = "Escribe para comenzar...";
            return;
        }

        // Ajustado con las propiedades reales de tu JSON: 'title' y 'summary'
        const resultadosFiltrados = listaAcuerdos.filter((item: any) => {
            const title = item.title ? item.title.toLowerCase() : '';
            const summary = item.summary ? item.summary.toLowerCase() : '';
            return title.includes(termino) || summary.includes(termino);
        });

        // Limpiar contenedor previo
        contenedorResultados.innerHTML = '';

        if (resultadosFiltrados.length === 0) {
            contenedorResultados.innerHTML = `
                <div class="bg-white p-8 rounded-xl border border-gray-200 text-center space-y-2">
                    <p class="text-gray-700 font-medium">No se encontraron registros coincidentes</p>
                    <p class="text-xs text-gray-500">Verifica la nomenclatura del expediente e intenta de nuevo.</p>
                </div>
            `;
            contadorResultados.textContent = "0 resultados encontrados";
            return;
        }

        // Limitamos los resultados para cuidar el rendimiento
        const topResultados = resultadosFiltrados.slice(0, 20);
        contadorResultados.textContent = `${resultadosFiltrados.length} resultados encontrados (mostrando los primeros 20)`;

        // Construir las tarjetas usando tus propiedades reales: title, date, summary, url
        topResultados.forEach((item: any) => {
            const tarjeta = document.createElement('div');
            tarjeta.className = "bg-white p-5 rounded-xl shadow-sm border border-gray-200 hover:border-blue-400 transition flex flex-col space-y-2";
            
            tarjeta.innerHTML = `
                <div class="flex justify-between items-start">
                    <h3 class="text-sm font-bold text-blue-900 tracking-tight">
                        ${item.title || 'Registro Oficial'}
                    </h3>
                    <span class="bg-blue-50 text-blue-700 text-xs font-semibold px-2 py-0.5 rounded border border-blue-100">
                        ${item.date || 'Reciente'}
                    </span>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed line-clamp-3">
                    ${item.summary || 'Sin extracto disponible.'}
                </p>
                ${item.url ? `
                    <div class="pt-2 border-t border-gray-100 flex justify-end">
                        <a href="${item.url}" target="_blank" class="text-xs font-semibold text-blue-600 hover:text-blue-800 flex items-center space-x-1">
                            <span>Ver documento original</span>
                            <span>→</span>
                        </a>
                    </div>
                ` : ''}
            `;
            contenedorResultados.appendChild(tarjeta);
        });
    }

    if (inputBusqueda) {
        inputBusqueda.addEventListener('input', filtrarDatos);
    }
</script>